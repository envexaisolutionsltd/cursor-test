html-ready',
+        complete: false,
+        startedAt: Date.now(),
+        error: null,
+      };
+      const status = () => document.querySelector('#loading-screen .loader-status');
+      const clean = (value) => String(value || 'Unknown startup error')
+        .replace(/\s+/g, ' ').trim().slice(0, 360);
+
+      window.__gevSetBootStage = (stage) => {
+        if (!state.complete) state.stage = clean(stage || 'unknown');
+      };
+      window.__gevBootComplete = () => {
+        state.stage = 'ready';
+        state.complete = true;
+      };
+      window.__gevBootFail = (error) => {
+        if (state.complete) return;
+        const detail = clean(error?.stack || error?.message || error);
+        state.error = detail;
+        const el = status();
+        if (el) {
+          el.textContent = `STARTUP ERROR · ${detail}`;
+          el.style.color = '#ff6b6b';
+          el.style.opacity = '1';
+          el.style.maxWidth = '760px';
+        }
+        console.error('[GEV boot]', error);
+      };
+
+      window.addEventListener('error', (event) => {
+        if (event.target && event.target !== window) {
+          const tag = event.target.tagName;
+          if (tag === 'SCRIPT') {
+            window.__gevBootFail(new Error(`Required script failed to load: ${event.target.src || 'unknown script'}`));
+          }
+          return;
+        }
+        window.__gevBootFail(event.error || new Error(event.message || 'Browser startup error'));
+      }, true);
+      window.addEventListener('unhandledrejection', (event) => {
+        window.__gevBootFail(event.reason || new Error('Unhandled startup promise rejection'));
+      });
+
+      window.setTimeout(() => {
+        if (!state.complete) {
+          window.__gevBootFail(new Error(`Startup stalled at ${state.stage}`));
+        }
+      }, 45000);
+    })();
+  </script>
   <script type="module" src="/src/main.js"></script>
 </body>
 </html>
