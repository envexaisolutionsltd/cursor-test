{
  "name": "gods-eye-view-free-commercial",
  "private": true,
  "version": "0.6.3",
  "description": "God's Eye View with a Next.js server layer and free commercial intelligence providers.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "npm run build:client",
    "dev": "next dev",
    "prebuild": "npm run validate:deps && npm run validate && npm run test && npm run typecheck && npm run build:client && npm run validate:client",
    "build": "next build",
    "build:client": "node scripts/build-gev-client.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-commercial-tests.mjs",
    "test:world": "node scripts/run-unit-tests.mjs",
    "doctor": "node scripts/setup-doctor.mjs",
    "validate": "node scripts/validate-release.mjs",
    "postinstall": "node scripts/postinstall-chromium.mjs",
    "validate:deps": "node scripts/validate-installed-deps.mjs",
    "validate:client": "node scripts/validate-built-client.mjs",
    "preinstall": "bash bootstrap.sh"
  },
  "dependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@sparticuz/chromium-min": "149.0.0",
    "cesium": "1.124.0",
    "egm96-universal": "1.1.1",
    "mgrs": "2.1.0",
    "next": "16.3.4",
    "pbf": "5.1.2",
    "pmtiles": "4.5.0",
    "puppeteer-core": "25.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "satellite.js": "6.0.2"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "sharp": "0.34.5",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "ws": "8.21.0",
    "@sparticuz/chromium": "149.0.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}
